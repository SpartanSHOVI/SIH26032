    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.7.5",
