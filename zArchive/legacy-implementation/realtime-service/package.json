{
  "name": "annsetu-realtime",
  "version": "1.0.0",
  "description": "AnnSetu Real-time WebSocket Service for Live Queue Updates",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "openapi-generator-cli generate -g typescript-axios -i ../spring-boot/target/openapi.yaml -o src/generated/api"
  },
  "dependencies": {
    "socket.io": "^4.7.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@openapitools/openapi-generator-cli": "^2.15.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}